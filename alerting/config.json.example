{
  "_comment_api": "Base URL of the Monitoring API",
  "api_base": "https://api.remote-backups.com",
  
  "_comment_ntfy": "Push notification settings. Configure ntfy_topic to enable external notifications. Leave empty to disable.",
  "ntfy_url": "https://ntfy.sh",
  "ntfy_topic": "",
  "ntfy_token": "",
  
  "_comment_heartbeat": "Optional HTTP(S) GET ping URLs. heartbeat_url is pinged when no alerts are detected (success). heartbeat_fail_url is pinged when alerts are detected (failure). If only heartbeat_url is set, no ping is sent on alerts — the timeout signals the problem. Uptime Kuma (Push monitor): copy the URL shown in the monitor and set status=up&msg=OK&ping= for heartbeat_url and status=down&msg=PROBLEM&ping= for heartbeat_fail_url — same token, different query parameters.",
  "heartbeat_url": "",
  "heartbeat_fail_url": "",

  "_comment_ignored": "List of objects describing backup groups to ignore.",
  "ignored_groups": [],
  
  "_comment_thresholds": "Warning and critical thresholds for datastore events. replication_stale_multiplier and replication_stale_grace_minutes control when the 'Replication Stale' alert fires: threshold_minutes = max(interval + grace, interval * multiplier). Multiplier must be > 1.0 (otherwise an alert would fire on every interval).",
  "thresholds": {
    "storage_warn_percent": 80,
    "storage_crit_percent": 90,
    "gc_max_age_hours": 36,
    "verification_max_age_days": 14,
    "replication_stale_multiplier": 2.0,
    "replication_stale_grace_minutes": 30
  },
  
  "_comment_quiet_hours": "Suppresses lower-priority alerts during specified hours.",
  "quiet_hours": {
    "enabled": false,
    "start": "22:00",
    "end": "07:00",
    "min_priority": 4
  },

  "_comment_priorities": "ntfy priority for outgoing alerts. Range 1–5 (5=urgent, bypasses DND). 'warning' and 'critical' are tier defaults. 'per_alert' lets you override the priority for individual alert types (use the key names from the web UI). Omit a key or set it to null to fall back to the tier default.",
  "notification_priorities": {
    "warning": 4,
    "critical": 5,
    "per_alert": {}
  },
  
  "_comment_learning": "Toggles dynamic learning for missed backup window detection. When downgrade_when_offschedule is true, missed-backup alerts are sent at normal priority (instead of high) and suppressed until the next expected snapshot if an off-schedule backup was already detected on the same day. snapshot_retention_count also caps how many snapshots per group are shown in the backup browser. observed_snapshot_history_max is the longer-term snapshot history retained for schedule inference.",
  "schedule_learning": {
    "enabled": true,
    "timezone": "local",
    "history_window_days": 60,
    "min_occurrences": 2,
    "time_tolerance_minutes": 30,
    "due_grace_minutes": 30,
    "stale_after_days": 8,
    "snapshot_retention_count": 50,
    "observed_snapshot_history_max": 1000,
    "downgrade_when_offschedule": true
  },
  
  "_comment_cooldown": "Minimum minutes to wait before repeating an alert of the same type.",
  "alert_cooldown_minutes": 60,

  "_comment_daemon": "Interval for daemon mode checks in seconds.",
  "daemon_interval_seconds": 1800,

  "_comment_storage_history": "Retention and sampling for the per-datastore usage-history chart. Samples are collected by the alerting daemon on each run. Tiered downsampling moves aged samples into coarser buckets: raw → hourly (median per hour) → 6-hourly (median per 6h) → daily (median per day). raw_retention_days: how long raw samples are kept before being promoted to the hourly tier. hourly_retention_days: how long hourly medians are kept before being promoted to 6-hourly. sixhour_retention_days: how long 6-hourly medians are kept before being promoted to daily. daily_retention_days: null = keep daily medians forever, otherwise days to retain. min_sample_interval_seconds: minimum spacing between raw samples (dedup for rapid daemon reruns). rescale_history_max_entries: max number of plan-rescale events (shown as markers on the chart) retained per datastore.",
  "storage_history": {
    "raw_retention_days": 7,
    "hourly_retention_days": 30,
    "sixhour_retention_days": 90,
    "daily_retention_days": null,
    "min_sample_interval_seconds": 300,
    "rescale_history_max_entries": 1000
  },

  "_comment_status_feed": "Enrich backup-/API-related alerts with context from the remote-backups.com status page. When a backup-related alert fires, the daemon fetches the status feed (cached in-process) and appends any currently-open or recently-overlapping incidents affecting the configured host. 'url' points at the JSON feed. 'cache_minutes' limits how often the feed is re-fetched. 'lookback_minutes' controls how far back from the alert time an incident is still considered 'possibly related'. 'default_host' is the global fallback host used for matching (e.g. 'dus1-1.pbs-host.de'); per-datastore / per-namespace overrides live in 'host_overrides'.",
  "status_feed": {
    "enabled": true,
    "url": "https://status.remote-backups.com/index.json",
    "cache_minutes": 10,
    "lookback_minutes": 120,
    "default_host": ""
  },

  "_comment_host_overrides": "Per-datastore (and optionally per-namespace) overrides for the host used when matching alerts against the status feed. Each entry: {datastore_id, namespace, host}. An empty namespace applies to the whole datastore. Resolution picks the most specific match: (datastore_id, namespace) > (datastore_id, '') > status_feed.default_host.",
  "host_overrides": [],

  "_comment_sources": "Optional list of datastore sources (cloud + local PBS). Leave empty [] to use the top-level api_base as a single implicit remote_backups source. Each entry: {id (slug: ^[a-z0-9][a-z0-9-]*$), type ('remote_backups' or 'pbs'), ...}. For type='remote_backups': {api_base, api_key_env (env var holding the Bearer token, default 'API_KEY')}. Entries with type='pbs' are reserved for Phase 4 of the multi-source plan.",
  "sources": []
}
